# Copy to apps/api/.env for local development.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://waven:waven@localhost:5432/waven
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated origins allowed by CORS (normal traffic goes through the web proxy).
CORS_ORIGINS=http://localhost:3000

# Public origin of the web app (OAuth redirects there; refresh checks Origin against it).
WEB_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client ID,
# type "Web application"). Add GOOGLE_CALLBACK_URL as an authorized redirect URI and
# http://localhost:3000 as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Access JWT: at least 32 random chars (e.g. `openssl rand -base64 48`). TTL in seconds.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
# Refresh token lifetime in days.
REFRESH_TTL_DAYS=30

# Comma-separated emails that get the admin role when they sign in.
ADMIN_EMAILS=

# Test-only login route. Ignored unless NODE_ENV=test.
E2E_AUTH_BYPASS=false

# Storage: `local` (disk, dev) or `s3` (any S3-compatible bucket, e.g. Cloudflare R2).
STORAGE_DRIVER=local
# Relative to apps/api. Gitignored.
STORAGE_LOCAL_DIR=../../storage
# Only with STORAGE_DRIVER=s3. R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of cover and artist images (a public bucket or CDN in production).
MEDIA_PUBLIC_URL=http://localhost:3000/api/media

# Signed stream URLs (64 hex chars, e.g. `openssl rand -hex 32`). TTL in seconds.
STREAM_BASE_URL=http://localhost:3000/api
STREAM_TOKEN_SECRET=
STREAM_TOKEN_TTL=3600

# Transcoding jobs running at the same time. FFMPEG_PATH overrides the bundled binary.
MEDIA_CONCURRENCY=2
FFMPEG_PATH=

# Jamendo seed (`pnpm seed`): free client id from https://devportal.jamendo.com
JAMENDO_CLIENT_ID=
SEED_TRACK_COUNT=300
