# Copy to .env at the repository root. Docker Compose reads it automatically, and
# the API reads it as a fallback for apps/api/.env (see apps/api/.env.example).
# Host ports for the Postgres containers. Change them if another Postgres already
# uses 5432/5433, and keep DATABASE_URL in sync.
DB_PORT=5432
DB_TEST_PORT=5433
DATABASE_URL=postgres://waven:waven@localhost:5432/waven
